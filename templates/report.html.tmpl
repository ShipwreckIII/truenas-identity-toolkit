<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{TITLE}}</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #f7f7f8;
    --fg: #1c1c1e;
    --card-bg: #ffffff;
    --border: #d8d8dc;
    --accent: #2f6fed;
    --warn-bg: #fff4e5;
    --warn-fg: #7a4b00;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1c1e;
      --fg: #f2f2f7;
      --card-bg: #262629;
      --border: #3a3a3d;
      --accent: #6ea1ff;
      --warn-bg: #3a2e00;
      --warn-fg: #ffce66;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 24px;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.45;
  }
  .wrap { max-width: 1100px; margin: 0 auto; }
  h1 { font-size: 1.6rem; margin-bottom: 4px; }
  .subtitle { color: #888; margin-top: 0; margin-bottom: 20px; }
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 20px;
  }
  .meta-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 16px;
  }
  .meta-card .label { font-size: 0.75rem; text-transform: uppercase; color: #888; }
  .meta-card .value { font-size: 1.1rem; font-weight: 600; }
  .notice {
    background: var(--warn-bg);
    color: var(--warn-fg);
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 20px;
    font-size: 0.9rem;
  }
  section { margin-bottom: 32px; }
  h2 { font-size: 1.2rem; border-bottom: 1px solid var(--border); padding-bottom: 6px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  th, td {
    text-align: left;
    padding: 6px 10px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    word-break: break-word;
  }
  th { color: #888; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
  tr:hover td { background: rgba(127,127,127,0.08); }
  code, .mono { font-family: var(--mono); font-size: 0.85em; }
  .badge {
    display: inline-block;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .badge-yes { background: #1f8b4c22; color: #1f8b4c; }
  .badge-no { background: #88888822; color: #888; }
  footer { color: #888; font-size: 0.75rem; margin-top: 40px; text-align: center; }
</style>
</head>
<body>
<div class="wrap">
  <h1>TrueNAS Identity Toolkit &ndash; Report</h1>
  <p class="subtitle">Generated {{GENERATED_AT}}</p>

  <div class="meta-grid">
    <div class="meta-card"><div class="label">Source</div><div class="value">{{SOURCE}}</div></div>
    <div class="meta-card"><div class="label">Source Host</div><div class="value">{{SOURCE_HOST}}</div></div>
    <div class="meta-card"><div class="label">Source Version</div><div class="value">{{SOURCE_VERSION}}</div></div>
    <div class="meta-card"><div class="label">Tool Version</div><div class="value">{{TOOL_VERSION}}</div></div>
    <div class="meta-card"><div class="label">Users</div><div class="value">{{USER_COUNT}}</div></div>
    <div class="meta-card"><div class="label">Groups</div><div class="value">{{GROUP_COUNT}}</div></div>
  </div>

  {{HASH_NOTICE}}

  <section>
    <h2>Users</h2>
    <table>
      <thead>
        <tr>
          <th>Username</th><th>UID</th><th>Full Name</th><th>Primary Group</th>
          <th>Home</th><th>Shell</th><th>Locked</th><th>SMB</th><th>Sudo</th>
          <th>Aux Groups</th><th>Hashes</th>
        </tr>
      </thead>
      <tbody>
{{USERS_TABLE_ROWS}}
      </tbody>
    </table>
  </section>

  <section>
    <h2>Groups</h2>
    <table>
      <thead>
        <tr><th>Name</th><th>GID</th><th>SMB</th><th>Sudo</th><th>Member Count</th></tr>
      </thead>
      <tbody>
{{GROUPS_TABLE_ROWS}}
      </tbody>
    </table>
  </section>

  <footer>Generated by truenas-identity-toolkit {{TOOL_VERSION}} &mdash; hashes, if any, are never rendered in this report.</footer>
</div>
</body>
</html>
